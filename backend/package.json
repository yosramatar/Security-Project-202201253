{
  "name": "healthcurealpha-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "keyvault:provision": "node scripts/provision-keyvault-secrets.js",
    "keyvault:rotate": "node scripts/provision-keyvault-secrets.js rotate HCA_ENC_KEY",
    "security:audit": "npm audit --omit=dev",
    "security:sast": "eslint . --ext .js",
    "security:postman": "newman run ../tests/security/healthcurealpha.postman_collection.json --env-var baseUrl=http://localhost:3000",
    "security:test": "npm run security:audit && npm run security:sast && npm run security:postman",
    "siem:test": "node scripts/test-siem-webhook.js"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^16.4.5",
    "helmet": "^8.1.0",
    "openid-client": "^6.8.1",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "newman": "^6.1.1"
  },
  "overrides": {
    "better-sqlite3": {
      "node-addon-api": "^7.1.0"
    }
  }
}
