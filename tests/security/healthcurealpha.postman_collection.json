  "item": [
    {
      "name": "Root should deny",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Server should respond with 404 for root path', function () {",
              "  pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Response should not leak stack traces', function () {",
              "  pm.expect(pm.response.text()).to.not.include('Error:');",
              "});"
            ]
          }
        }
      ]
    },
